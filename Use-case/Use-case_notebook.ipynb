   "cell_type": "markdown",
   "id": "f69a3261",
   "metadata": {},
   "source": [
    "# TODO: optimalisatie resultaten nodig?! 9 of 3 resultaten??"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "b4cbdd21",
   "metadata": {},
   "outputs": [],
   "source": [
    "# berekenen BIC, AIC & AICc\n",
    "def calculate_BIC_AIC_AICc(ys_input, best_result, solver_results):\n",
    "\n",
    "    for name, result in solver_results.items():\n",
    "        ts_model, ys_model = result\n",
    "\n",
    "\n",
    "    r, K, mse = best_result\n",
    "    n, k = len(ys_model), len(best_result)-1 #mse erafhalen om aantal parameters te krijgen\n",
    "    \n",
    "    BIC  = n * math.log(mse) + k * math.log(n)\n",
    "    AIC  = n * math.log(mse) + k * 2.0\n",
    "    AICc = n * math.log(mse) + k * 2.0 * n/(n-k-1) \n",
    "   \n",
    "   \n",
    "    return f\"{BIC  = :.1f},\\n {AIC  = :.1f},\\n {AICc = :.1f}\""
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c795c949",
   "metadata": {},
   "source": []
  },
  {
   "cell_type": "markdown",
   "id": "94adbe8e",
